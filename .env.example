# ── Tajurba environment ────────────────────────────────────────────
# Copy to .env and fill in. Nothing here is required for local dev
# except SECRET_KEY if you set ENVIRONMENT=production.

# development | production | test
ENVIRONMENT=development

# Required in production. Generate with:
#   python -c "import secrets; print(secrets.token_urlsafe(48))"
SECRET_KEY=

# JWT lifetime in minutes (default 12 hours)
ACCESS_TOKEN_EXPIRE_MINUTES=720

# SQLite by default; docker-compose overrides this with Postgres.
#   sqlite:///./tajurba.db
#   postgresql+psycopg://tajurba:tajurba@db:5432/tajurba
DATABASE_URL=sqlite:///./tajurba.db

# Upload limits
MAX_UPLOAD_BYTES=5242880
MAX_ROWS=20000

# Rate limits (slowapi syntax: "<count>/<period>")
LOGIN_RATE_LIMIT=10/minute
TRAIN_RATE_LIMIT=20/hour

# Comma-separated origins, or * for any
CORS_ORIGINS=*

# Set to true for verbose logging
DEBUG=false
